# Copy to .env for local `npm run dev` / `npm run build`.
# Every value comes from `terraform output` (see Doc/deployment.md).

# terraform output -raw api_base_url
VITE_API_BASE_URL=https://REPLACE_ME.execute-api.us-east-1.amazonaws.com

# terraform output -raw cognito_domain (no https://)
VITE_COGNITO_DOMAIN=REPLACE_ME.auth.us-east-1.amazoncognito.com

# terraform output -raw cognito_client_id
# Cognito's public app client id, not your IdP's client id.
VITE_COGNITO_CLIENT_ID=REPLACE_ME

# terraform output -raw cognito_idp_name
# Optional. When set, login goes straight to that SSO provider.
VITE_COGNITO_IDP_NAME=
